# Application
APP_ENV=local
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (fictitious local examples; use isolated credentials outside Git)
DATABASE_URL=mysql://example_user:example_password@127.0.0.1:3307/lessenc_dev
DB_RUNTIME_URL=mysql://example_runtime_user:example_password@127.0.0.1:3307/lessenc_dev
TEST_DATABASE_URL=mysql://example_test_user:example_password@127.0.0.1:3307/lessenc_test
SHADOW_DATABASE_URL=mysql://example_migrate_user:example_password@127.0.0.1:3307/lessenc_shadow
DB_TLS_CA_FILE=./output/p06/ca.pem

# P16 hosted DB access control (non-secret)
P16_DATABASE_ACCESS_MODEL=distinct-users
P16_DATABASE_MIGRATION_WINDOW=disabled

# Mercado Pago - use only test credentials locally
MERCADOPAGO_ACCESS_TOKEN=replace_with_test_token
MERCADOPAGO_WEBHOOK_SECRET=replace_with_test_secret
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
P10_PAYMENT_CONTINUATION_SECRET=
P11_BUYER_SESSION_SECRET=
P16_READINESS_TOKEN=

# Private file storage
PRIVATE_STORAGE_DRIVER=local-filesystem
PRIVATE_FILE_STORAGE_PATH=C:/replace_with_absolute_private_storage_path

# P16 hosted private storage — Cloudflare R2
# Real credentials and provider identifiers remain outside Git.
P16_PRIVATE_STORAGE_PROVIDER=
PRIVATE_STORAGE_S3_ENDPOINT=
PRIVATE_STORAGE_S3_REGION=auto
PRIVATE_STORAGE_S3_BUCKET=
PRIVATE_STORAGE_S3_ACCESS_KEY_ID=
PRIVATE_STORAGE_S3_SECRET_ACCESS_KEY=
PRIVATE_STORAGE_HEALTHCHECK_KEY=_health/p16-readiness

# P16 staging deployment identity and release metadata (non-secret)
P16_STAGING_ENVIRONMENT_ID=
P16_RELEASE_COMMIT=

# Analytics
# Public GTM web-container identifier. Leave blank to keep Google tags disabled.
GTM_CONTAINER_ID=
META_PIXEL_ID=replace_with_pixel_id
META_CAPI_ACCESS_TOKEN=replace_with_test_token

# P08 — Public Sales Experience
# Server-only persistent identifiers for the canonical public offer.
P08_PRODUCT_ID=
P08_OFFER_ID=
# P09 — Checkout & Order Creation
# Server-only HMAC secret. Use a strong secret with at least 32 characters.
P09_SUBMISSION_SECRET=

# P12 — isolated administrative authentication (server only, at least 32 characters)
P12_ADMIN_AUTH_SECRET=
