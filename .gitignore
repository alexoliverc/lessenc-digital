# Dependencies
node_modules/
.pnp/
.pnp.js

# Build output
.next/
src/generated/prisma/
out/
dist/
coverage/

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Local files and caches
.DS_Store
Thumbs.db
.turbo/
*.log
tmp/
output/

# P17 performance capsule: the acquired npm payload is local evidence and must
# never be staged. Keep only the empty directory marker and reviewed manifests.
e2e/performance/capsule/offline/npm-cache/**
!e2e/performance/capsule/offline/npm-cache/.gitkeep

# Local IDE state
.vscode/*.local.json

# Next.js / TypeScript generated files
next-env.d.ts
*.tsbuildinfo
