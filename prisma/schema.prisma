generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
  REFUNDED
  UNKNOWN
}

enum EntitlementStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

enum BuyerAccessCredentialStatus {
  ACTIVE
  REVOKED
}

enum DigitalResourceStatus {
  ACTIVE
  INACTIVE
}

enum DigitalDeliveryOutcome {
  SUCCEEDED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEventType {
  ORDER_PAID
  PAYMENT_APPROVED
  ENTITLEMENT_ACTIVATED
  REFUND_COMPLETED
  ACCESS_REISSUE_REQUESTED
}

enum AdminRole {
  OWNER
  ADMIN
  SUPPORT
}

enum AdminAuditOutcome {
  SUCCEEDED
  DENIED
  FAILED
}

model Product {
  id               String                   @id @default(uuid()) @db.Char(36)
  name             String                   @db.VarChar(160)
  description      String?                  @db.Text
  status           ProductStatus            @default(DRAFT)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.DateTime(3)
  offers           Offer[]
  items            OrderItem[]
  digitalResources ProductDigitalResource[]

  @@map("products")
}

model Offer {
  id         String      @id @default(uuid()) @db.Char(36)
  productId  String      @map("product_id") @db.Char(36)
  priceMinor Int         @map("price_minor") @db.UnsignedInt
  currency   String      @db.Char(3)
  isActive   Boolean     @default(false) @map("is_active")
  createdAt  DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items      OrderItem[]

  @@index([productId])
  @@map("offers")
}

model Customer {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @db.VarChar(320)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  orders    Order[]

  @@index([email])
  @@map("customers")
}

model Order {
  id                     String                  @id @default(uuid()) @db.Char(36)
  customerId             String                  @map("customer_id") @db.Char(36)
  status                 OrderStatus             @default(PENDING)
  totalMinor             Int                     @map("total_minor") @db.UnsignedInt
  currency               String                  @db.Char(3)
  createdAt              DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  paidAt                 DateTime?               @map("paid_at") @db.DateTime(3)
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  items                  OrderItem[]
  payments               Payment[]
  outbox                 OutboxEvent[]
  buyerAccessCredentials BuyerAccessCredential[]
  attribution            OrderAttribution?

  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id                         String       @id @default(uuid()) @db.Char(36)
  orderId                    String       @map("order_id") @db.Char(36)
  productId                  String       @map("product_id") @db.Char(36)
  offerId                    String       @map("offer_id") @db.Char(36)
  productNameSnapshot        String       @map("product_name_snapshot") @db.VarChar(160)
  productDescriptionSnapshot String?      @map("product_description_snapshot") @db.Text
  unitPriceMinor             Int          @map("unit_price_minor") @db.UnsignedInt
  quantity                   Int          @db.UnsignedInt
  totalMinor                 Int          @map("total_minor") @db.UnsignedInt
  currency                   String       @db.Char(3)
  createdAt                  DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  order                      Order        @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  product                    Product      @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  offer                      Offer        @relation(fields: [offerId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entitlement                Entitlement?

  @@index([orderId])
  @@index([productId])
  @@index([offerId])
  @@map("order_items")
}

model Payment {
  id                   String         @id @default(uuid()) @db.Char(36)
  orderId              String         @map("order_id") @db.Char(36)
  status               PaymentStatus  @default(PENDING)
  amountMinor          Int            @map("amount_minor") @db.UnsignedInt
  currency             String         @db.Char(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  approvedAt           DateTime?      @map("approved_at") @db.DateTime(3)
  provider             String?        @db.VarChar(32)
  providerOrderId      String?        @unique @map("provider_order_id") @db.VarChar(64)
  providerPaymentId    String?        @unique @map("provider_payment_id") @db.VarChar(64)
  attemptNumber        Int?           @map("attempt_number") @db.UnsignedInt
  activeAttemptKey     String?        @unique @map("active_attempt_key") @db.Char(36)
  paymentMethod        String?        @map("payment_method") @db.VarChar(16)
  operationFingerprint String?        @map("operation_fingerprint") @db.Char(64)
  providerStatus       String?        @map("provider_status") @db.VarChar(64)
  providerStatusDetail String?        @map("provider_status_detail") @db.VarChar(128)
  submittedAt          DateTime?      @map("submitted_at") @db.DateTime(3)
  lastProviderSyncAt   DateTime?      @map("last_provider_sync_at") @db.DateTime(3)
  requiresReview       Boolean        @default(false) @map("requires_review")
  reviewReason         String?        @map("review_reason") @db.VarChar(96)
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  events               PaymentEvent[]

  @@unique([orderId, attemptNumber])
  @@index([orderId])
  @@map("payments")
}

model PaymentEvent {
  id                   String    @id @default(uuid()) @db.Char(36)
  paymentId            String    @map("payment_id") @db.Char(36)
  source               String    @db.VarChar(24)
  providerOrderId      String?   @map("provider_order_id") @db.VarChar(64)
  providerPaymentId    String?   @map("provider_payment_id") @db.VarChar(64)
  providerEventId      String?   @map("provider_event_id") @db.VarChar(64)
  providerStatus       String    @map("provider_status") @db.VarChar(64)
  providerStatusDetail String?   @map("provider_status_detail") @db.VarChar(128)
  amountMinor          Int?      @map("amount_minor") @db.UnsignedInt
  currency             String?   @db.Char(3)
  deduplicationKey     String    @unique @map("deduplication_key") @db.VarChar(160)
  snapshotHash         String    @map("snapshot_hash") @db.Char(64)
  applicationResult    String    @map("application_result") @db.VarChar(16)
  observedAt           DateTime  @default(now()) @map("observed_at") @db.DateTime(3)
  providerOccurredAt   DateTime? @map("provider_occurred_at") @db.DateTime(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  payment              Payment   @relation(fields: [paymentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([paymentId, observedAt])
  @@index([providerOrderId])
  @@map("payment_events")
}

model Entitlement {
  id                  String                       @id @default(uuid()) @db.Char(36)
  orderItemId         String                       @unique @map("order_item_id") @db.Char(36)
  sourceOutboxEventId String?                      @map("source_outbox_event_id") @db.Char(36)
  status              EntitlementStatus            @default(PENDING)
  createdAt           DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  activatedAt         DateTime?                    @map("activated_at") @db.DateTime(3)
  revokedAt           DateTime?                    @map("revoked_at") @db.DateTime(3)
  orderItem           OrderItem                    @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceOutboxEvent   OutboxEvent?                 @relation(fields: [sourceOutboxEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resources           EntitlementDigitalResource[]

  @@index([sourceOutboxEventId])
  @@map("entitlements")
}

model BuyerAccessCredential {
  id             String                      @id @default(uuid()) @db.Char(36)
  orderId        String                      @map("order_id") @db.Char(36)
  secretHash     String                      @unique @map("secret_hash") @db.Char(64)
  status         BuyerAccessCredentialStatus @default(ACTIVE)
  activeOrderKey String?                     @unique @map("active_order_key") @db.Char(36)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime                    @updatedAt @map("updated_at") @db.DateTime(3)
  lastUsedAt     DateTime?                   @map("last_used_at") @db.DateTime(3)
  revokedAt      DateTime?                   @map("revoked_at") @db.DateTime(3)
  order          Order                       @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveryEvents DigitalDeliveryEvent[]

  @@index([orderId, createdAt])
  @@map("buyer_access_credentials")
}

model DigitalResource {
  id           String                       @id @default(uuid()) @db.Char(36)
  logicalKey   String                       @map("logical_key") @db.VarChar(160)
  version      Int                          @default(1) @db.UnsignedInt
  storageKey   String                       @unique @map("storage_key") @db.VarChar(512)
  filename     String                       @db.VarChar(255)
  mediaType    String                       @map("media_type") @db.VarChar(127)
  status       DigitalResourceStatus        @default(ACTIVE)
  createdAt    DateTime                     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime                     @updatedAt @map("updated_at") @db.DateTime(3)
  products     ProductDigitalResource[]
  entitlements EntitlementDigitalResource[]

  @@unique([logicalKey, version])
  @@map("digital_resources")
}

model ProductDigitalResource {
  productId  String          @map("product_id") @db.Char(36)
  resourceId String          @map("resource_id") @db.Char(36)
  createdAt  DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource   DigitalResource @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([productId, resourceId])
  @@index([resourceId])
  @@map("product_digital_resources")
}

model EntitlementDigitalResource {
  entitlementId String                 @map("entitlement_id") @db.Char(36)
  resourceId    String                 @map("resource_id") @db.Char(36)
  grantedAt     DateTime               @default(now()) @map("granted_at") @db.DateTime(3)
  entitlement   Entitlement            @relation(fields: [entitlementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resource      DigitalResource        @relation(fields: [resourceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  deliveries    DigitalDeliveryEvent[]

  @@id([entitlementId, resourceId])
  @@index([resourceId])
  @@map("entitlement_digital_resources")
}

model DigitalDeliveryEvent {
  id                      String                     @id @default(uuid()) @db.Char(36)
  entitlementId           String                     @map("entitlement_id") @db.Char(36)
  resourceId              String                     @map("resource_id") @db.Char(36)
  buyerAccessCredentialId String                     @map("buyer_access_credential_id") @db.Char(36)
  outcome                 DigitalDeliveryOutcome
  failureCode             String?                    @map("failure_code") @db.VarChar(64)
  createdAt               DateTime                   @default(now()) @map("created_at") @db.DateTime(3)
  entitlementResource     EntitlementDigitalResource @relation(fields: [entitlementId, resourceId], references: [entitlementId, resourceId], onDelete: Restrict, onUpdate: Restrict)
  buyerAccessCredential   BuyerAccessCredential      @relation(fields: [buyerAccessCredentialId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([entitlementId, resourceId])
  @@index([entitlementId, createdAt])
  @@index([resourceId, createdAt])
  @@index([buyerAccessCredentialId, createdAt])
  @@map("digital_delivery_events")
}

model BuyerAccessRateLimitBucket {
  scope        String   @db.VarChar(32)
  bucketHash   String   @map("bucket_hash") @db.Char(64)
  windowStart  DateTime @map("window_start") @db.DateTime(3)
  requestCount Int      @default(0) @map("request_count") @db.UnsignedInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@id([scope, bucketHash, windowStart])
  @@index([windowStart])
  @@map("buyer_access_rate_limit_buckets")
}

model OutboxEvent {
  id                    String            @id @default(uuid()) @db.Char(36)
  orderId               String            @map("order_id") @db.Char(36)
  type                  OutboxEventType
  status                OutboxEventStatus @default(PENDING)
  deduplicationKey      String            @unique @map("deduplication_key") @db.VarChar(160)
  payload               Json
  createdAt             DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  processedAt           DateTime?         @map("processed_at") @db.DateTime(3)
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  activatedEntitlements Entitlement[]

  @@index([orderId])
  @@index([status, createdAt])
  @@map("outbox_events")
}

model AdminUser {
  id               String            @id @db.VarChar(64)
  name             String            @db.Text
  email            String            @unique @db.VarChar(320)
  emailVerified    Boolean           @default(false) @map("email_verified")
  image            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  twoFactorEnabled Boolean?          @default(false) @map("two_factor_enabled")
  role             AdminRole         @default(SUPPORT)
  sessions         AdminSession[]
  accounts         AdminAccount[]
  twoFactors       AdminTwoFactor[]
  auditEvents      AdminAuditEvent[]

  @@map("admin_users")
}

model AdminSession {
  id             String    @id @db.VarChar(64)
  expiresAt      DateTime  @map("expires_at") @db.DateTime(3)
  token          String    @unique @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.DateTime(3)
  ipAddress      String?   @map("ip_address") @db.Text
  userAgent      String?   @map("user_agent") @db.Text
  userId         String    @map("user_id") @db.VarChar(64)
  user           AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("admin_sessions")
}

model AdminAccount {
  id                    String    @id @db.VarChar(64)
  accountId             String    @map("account_id") @db.Text
  providerId            String    @map("provider_id") @db.Text
  userId                String    @map("user_id") @db.VarChar(64)
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.DateTime(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.DateTime(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([userId])
  @@map("admin_accounts")
}

model AdminVerification {
  id         String   @id @db.VarChar(64)
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([identifier(length: 191)])
  @@map("admin_verifications")
}

model AdminTwoFactor {
  id                      String    @id @db.VarChar(64)
  secret                  String    @db.Text
  backupCodes             String    @map("backup_codes") @db.Text
  userId                  String    @map("user_id") @db.VarChar(64)
  user                    AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0) @map("failed_verification_count")
  lockedUntil             DateTime? @map("locked_until") @db.DateTime(3)

  @@index([secret(length: 191)])
  @@index([userId])
  @@map("admin_two_factors")
}

model AdminAuthRateLimitBucket {
  id          String @id @db.VarChar(64)
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("admin_auth_rate_limit_buckets")
}

model AdminAuditEvent {
  id               String            @id @default(uuid()) @db.Char(36)
  actorAdminUserId String?           @map("actor_admin_user_id") @db.VarChar(64)
  actorRole        AdminRole?        @map("actor_role")
  action           String            @db.VarChar(96)
  targetType       String?           @map("target_type") @db.VarChar(64)
  targetId         String?           @map("target_id") @db.VarChar(128)
  outcome          AdminAuditOutcome
  metadata         Json?
  correlationId    String            @map("correlation_id") @db.VarChar(64)
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  actor            AdminUser?        @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorAdminUserId, createdAt])
  @@index([action, createdAt])
  @@index([correlationId])
  @@map("admin_audit_events")
}

// =============================================================================
// P13-B - Attribution Persistence Foundation
// =============================================================================

enum AnalyticsConsentState {
  UNKNOWN
  GRANTED
  DENIED
}

enum AttributionTouchType {
  CAMPAIGN
  REFERRAL
  DIRECT
}

enum AnalyticsEventType {
  VIEW_CONTENT
  INITIATE_CHECKOUT
  PURCHASE
}

enum AnalyticsDispatchStatus {
  PENDING
  PROCESSING
  RETRYABLE
  SUCCEEDED
  FAILED
  SUPPRESSED
}

model AcquisitionJourney {
  id                      String                @id @default(uuid()) @db.Char(36)
  createdAt               DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt              DateTime              @default(now()) @map("last_seen_at") @db.DateTime(3)
  expiresAt               DateTime              @map("expires_at") @db.DateTime(3)
  firstTouchId            String?               @map("first_touch_id") @db.Char(36)
  lastTouchId             String?               @map("last_touch_id") @db.Char(36)
  analyticsConsentState   AnalyticsConsentState @default(UNKNOWN) @map("analytics_consent_state")
  advertisingConsentState AnalyticsConsentState @default(UNKNOWN) @map("advertising_consent_state")
  policyVersion           String                @map("policy_version") @db.VarChar(64)
  touches                 AttributionTouch[]

  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([firstTouchId])
  @@index([lastTouchId])
  @@map("acquisition_journeys")
}

model AttributionTouch {
  id           String               @id @default(uuid()) @db.Char(36)
  journeyId    String               @map("journey_id") @db.Char(36)
  occurredAt   DateTime             @default(now()) @map("occurred_at") @db.DateTime(3)
  source       String?              @db.VarChar(96)
  medium       String?              @db.VarChar(96)
  campaign     String?              @db.VarChar(191)
  content      String?              @db.VarChar(191)
  term         String?              @db.VarChar(191)
  referrerHost String?              @map("referrer_host") @db.VarChar(253)
  landingPath  String?              @map("landing_path") @db.VarChar(1024)
  touchType    AttributionTouchType @map("touch_type")
  journey      AcquisitionJourney   @relation(fields: [journeyId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([journeyId, occurredAt])
  @@index([touchType, occurredAt])
  @@index([source, medium, campaign])
  @@map("attribution_touches")
}

model OrderAttribution {
  id            String   @id @default(uuid()) @db.Char(36)
  orderId       String   @unique @map("order_id") @db.Char(36)
  journeyId     String?  @map("journey_id") @db.Char(36)
  firstTouchId  String?  @map("first_touch_id") @db.Char(36)
  lastTouchId   String?  @map("last_touch_id") @db.Char(36)
  firstSource   String?  @map("first_source") @db.VarChar(96)
  firstMedium   String?  @map("first_medium") @db.VarChar(96)
  firstCampaign String?  @map("first_campaign") @db.VarChar(191)
  firstContent  String?  @map("first_content") @db.VarChar(191)
  firstTerm     String?  @map("first_term") @db.VarChar(191)
  lastSource    String?  @map("last_source") @db.VarChar(96)
  lastMedium    String?  @map("last_medium") @db.VarChar(96)
  lastCampaign  String?  @map("last_campaign") @db.VarChar(191)
  lastContent   String?  @map("last_content") @db.VarChar(191)
  lastTerm      String?  @map("last_term") @db.VarChar(191)
  capturedAt    DateTime @default(now()) @map("captured_at") @db.DateTime(3)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([journeyId])
  @@index([firstTouchId])
  @@index([lastTouchId])
  @@index([capturedAt])
  @@index([firstSource, firstMedium])
  @@index([lastSource, lastMedium])
  @@map("order_attributions")
}

model AnalyticsEvent {
  id               String              @id @default(uuid()) @db.Char(36)
  type             AnalyticsEventType
  occurredAt       DateTime            @map("occurred_at") @db.DateTime(3)
  journeyId        String?             @map("journey_id") @db.Char(36)
  productId        String?             @map("product_id") @db.Char(36)
  offerId          String?             @map("offer_id") @db.Char(36)
  orderId          String?             @map("order_id") @db.Char(36)
  amountMinor      Int?                @map("amount_minor") @db.UnsignedInt
  currency         String?             @db.Char(3)
  attributionState String              @map("attribution_state") @db.VarChar(32)
  consentSnapshot  Json                @map("consent_snapshot")
  schemaVersion    Int                 @default(1) @map("schema_version") @db.UnsignedInt
  purchaseOrderKey String?             @unique @map("purchase_order_key") @db.Char(36)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  dispatches       AnalyticsDispatch[]

  @@index([type, occurredAt])
  @@index([journeyId, occurredAt])
  @@index([orderId])
  @@index([productId])
  @@index([offerId])
  @@map("analytics_events")
}

model AnalyticsDispatch {
  id               String                  @id @default(uuid()) @db.Char(36)
  analyticsEventId String                  @map("analytics_event_id") @db.Char(36)
  provider         String                  @db.VarChar(32)
  channel          String                  @db.VarChar(32)
  status           AnalyticsDispatchStatus @default(PENDING)
  attemptCount     Int                     @default(0) @map("attempt_count") @db.UnsignedInt
  nextAttemptAt    DateTime?               @map("next_attempt_at") @db.DateTime(3)
  lastAttemptAt    DateTime?               @map("last_attempt_at") @db.DateTime(3)
  providerEventId  String?                 @map("provider_event_id") @db.VarChar(128)
  lastErrorCode    String?                 @map("last_error_code") @db.VarChar(64)
  lastErrorClass   String?                 @map("last_error_class") @db.VarChar(64)
  createdAt        DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  completedAt      DateTime?               @map("completed_at") @db.DateTime(3)
  analyticsEvent   AnalyticsEvent          @relation(fields: [analyticsEventId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([analyticsEventId, provider, channel])
  @@index([status, nextAttemptAt])
  @@index([provider, status, nextAttemptAt])
  @@map("analytics_dispatches")
}
